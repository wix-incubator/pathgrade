{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "bin/pathgrade.js",
    "src/pathgrade.ts",
    "src/sdk/index.ts",
    "src/plugin/index.ts",
    "src/core/mcp-mock.ts",
    "vitest.config.ts",
    "evals/vitest.config.mts",
    "examples/**/vitest.config.mts",
    "scripts/*.ts"
  ],
  "project": [
